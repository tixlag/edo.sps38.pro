# --- Database (MariaDB via Prisma, provider=mysql) ---
DATABASE_URL="mysql://edo:edo@localhost:3307/edo"

# --- API ---
API_PORT=3001
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# --- Auth (external unified auth service, adapter boundary) ---
# Access JWT is validated by backend guard; exact issuer/JWKS comes from env.
# Frontend obtains tokens only via configured AUTH_* URLs, never ships its own login.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_REFRESH_URL=http://localhost:4000/auth/refresh
AUTH_LOGIN_URL=http://localhost:4000/auth/login
VITE_AUTH_REFRESH_URL=http://localhost:4000/auth/refresh
VITE_API_BASE_URL=http://localhost:3001

# --- Redis / BullMQ (host 6380: local 6379 is often taken by other projects) ---
REDIS_URL=redis://localhost:6380

# --- S3-compatible storage ---
# Default local: moto mock (compose service `s3` on :5000).
# Prod-like MinIO: `docker compose --profile minio up -d`, then S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT=http://localhost:5000
S3_REGION=us-east-1
S3_BUCKET=edo-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
