# ЭДО: корневой .env загружают API, Vite и серверные CLI.
# Скопируйте файл в .env и заполните пустые секреты. .env не коммитится.
# Значения ниже рассчитаны на production и общую Docker-сеть с ЛК.
# Учётные данные внутри URL необходимо URL-encode.

# --- API и браузерные адреса ---
NODE_ENV=production
API_PORT=3001
API_PREFIX=/api
CORS_ORIGIN=https://edo.sps38.pro,https://lk.sps38.pro
# Публичный origin API без /api; VITE_* доступны любому браузеру.
VITE_API_BASE_URL=https://edo.sps38.pro
# Публичный API с /api, доступный кандидатам для SSE.
EDO_PUBLIC_API_URL=https://edo.sps38.pro/api

# --- MariaDB: отдельная БД edo на сервере ЛК ---
# mariadb:3306 — адрес внутри общей Docker-сети; с хоста — 127.0.0.1:12002.
# EDO никогда не мигрирует sps_db/sps_next и не читает таблицы ЛК.
# Замените пароль; заведите отдельного пользователя с доступом только к edo.
DATABASE_URL="mysql://edo:<password>@mariadb:3306/edo"

# --- Общая авторизация ЛК: HS256 ---
# Тот же JWT_SECRET, что в auth-service; пустой секрет запрещает запуск.
JWT_SECRET=
JWT_ALG=HS256
JWT_ISSUER=lk-auth-service
ALLOW_INSECURE_DEV_AUTH=false
VITE_ALLOW_INSECURE_DEV_AUTH=false
# Версионированные production-ручки общего auth-service ЛК.
AUTH_LOGIN_URL=https://lk.sps38.pro/api/auth/v1/login
AUTH_REFRESH_URL=https://lk.sps38.pro/api/auth/v1/refresh-tokens
VITE_AUTH_REFRESH_URL=https://lk.sps38.pro/api/auth/v1/refresh-tokens

# --- Справочники ЛК: только узкий серверный контракт ЭДО ---
LK_BASE_URL=https://lk.sps38.pro
# Публичная база ЛК для ссылок из ЭДО на карточки сотрудников
# ({base}/public/employee/{code1C}?size_width=WIDE_1200). Видна в браузере.
VITE_LK_BASE_URL=https://lk.sps38.pro
# Для генерации packages/lk-client используется локальный узкий OpenAPI.
# Заполните URL только если обновляете спецификацию по HTTP.
LK_EDO_OPENAPI_URL=
# ЛК php_next EDO_INTERNAL_TOKEN ↔ EDO LK_EDO_INTERNAL_TOKEN.
LK_EDO_INTERNAL_TOKEN=

# --- Загрузка документов и связь chat UUID → code_1c: ЛК → ЭДО ---
# Независимый токен, не LK_EDO_INTERNAL_TOKEN и не пользовательский JWT.
# Только chat-server ЛК использует это значение для доставки employee-link.
# Браузеры и surveys этот сервисный секрет не получают.
# и EDO_API_BASE_URL=https://edo.sps38.pro (без /api).
EDO_LK_INTERNAL_TOKEN=
# 1С требует одновременно token и Basic; все три значения — серверные секреты.
# GET documents-by-positions / POST candidate-documents.
ERP_DOCUMENTS_BASE_URL=https://api-erp.sps38.pro/ERP/hs/api/
# Новые подтверждения используют v2 по указанию владельца. Для прежней ручки: base64-v1.
# Транспорт уже созданных доставок не меняется при переключении.
ERP_DOCUMENTS_TRANSPORT=multipart-v2
# Только после приемки идемпотентности в целевой 1С; до пяти попыток всего.
ERP_DOCUMENTS_V2_AUTO_RETRY=false
# Общий deadline S3+HTTP; lease доставки = timeout + 60 секунд.
ERP_DOCUMENTS_V2_TIMEOUT_MS=300000
ERP_DOCUMENTS_TOKEN=
# Карточка кандидата: прежний ERP Candidate endpoint; только сервер EDO.
ERP_CANDIDATE_URL=https://api-erp.sps38.pro/ERP/hs/api/Candidate
ERP_CANDIDATE_TOKEN=
ERP_USERNAME=
ERP_PASSWORD=
# Чат кандидата: новый узкий HTTP-сервис 1С, защищённый Basic + token.
# Публикуйте endpoint и назначайте сервисной учётной записи роль
# PROFI_APIКоммуникацииЭДО до включения синхронизации каталога.
# Токен HTTP_IN_API общий с Candidate: используется ERP_CANDIDATE_TOKEN выше.
ERP_COMMUNICATIONS_URL=
CANDIDATE_CATALOG_SYNC_ENABLED=true
# HTTP(S) адрес существующего chat-server ЛК; только сервер EDO.
LK_CANDIDATE_OPERATOR_TOKEN=
LK_CHAT_BASE_URL=
# Публичный nginx ЛК: ссылки кандидата и чтение /upload(s)/, не порт chat-server.
LK_PUBLIC_BASE_URL=https://lk.sps38.pro
# Доставка ERP, восстановление прерванных операций и очистка S3.
# Экспорт OpenAPI и управляемые тесты ставят false.
DOCUMENT_WORKER_ENABLED=true
# disabled сохраняет ручную проверку. external включать после успешного OCR runner.
OCR_MODE=disabled
OCR_WORKER_ENABLED=false
OCR_RU_BASE_URL=http://10.10.5.184:8001
OCR_UZ_BASE_URL=http://10.10.5.184:8000
OCR_REQUEST_TIMEOUT_MS=240000
EDO_OCR_QUEUE=edo.ocr

# --- RabbitMQ: общий брокер ЛК, не отдельный брокер ЭДО ---
# rabbitmq:5672 внутри общей Docker-сети; с хоста — 127.0.0.1:5672.
# Отдельный пользователь edo с доступом к lk.events и очередям edo.*.
# Сохраните vhost существующего LK exchange; не удаляйте рабочие очереди.
RABBITMQ_URL="amqp://edo:<password>@rabbitmq:5672/"
LK_EVENTS_EXCHANGE=lk.events
EDO_LK_QUEUE=edo.lk-reference-sync
LK_EVENTS_CONSUME=1

# --- Redis: общий Redis ЛК, только cache/locks, ключи edo:* ---
# redis:6379 внутри общей Docker-сети. В production используйте Redis ACL.
# Замените username/password своей серверной учётной записью Redis.
# В локальном ЛК без auth: redis://127.0.0.1:6379.
REDIS_URL="redis://<username>:<password>@redis:6379/0"

# --- Закрытое S3-совместимое хранилище документов ---
# Возьмите endpoint/region из production MINIO_ENDPOINT/MINIO_REGION ЛК.
# Production endpoint в доступных конфигурациях не указан — заполните его.
# Для EDO нужен отдельный закрытый bucket и ключ, не публичный bucket ЛК.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=edo-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
# CORS bucket: GET/HEAD, Range; expose Content-Length/Content-Range/Accept-Ranges/ETag.
# Origins: https://edo.sps38.pro; доступ к файлам только по подписанным URL.

# --- Инструменты GitLab, не переменные приложения ---
# Нужен только для управления MR через API glab.sps38.pro.
# Токен с api либо нужными granular permissions; никогда не VITE_GITLAB_TOKEN.
GITLAB_TOKEN=

# --- Только локальная разработка / e2e ---
# В production значения ниже не нужны. Для pnpm local:up измените в .env:
# NODE_ENV=development
# DATABASE_URL="mysql://edo:<password>@127.0.0.1:12002/edo"
# RABBITMQ_URL="amqp://edo:<password>@127.0.0.1:5672/"
# REDIS_URL=redis://127.0.0.1:6379
# CORS_ORIGIN=https://edo.localhost:12443,https://next.localhost:12443
# VITE_API_BASE_URL=https://edo.localhost:12443
# EDO_PUBLIC_API_URL=https://edo.localhost:12443/api
# LK_BASE_URL=https://next.localhost:12443
# AUTH_LOGIN_URL=https://next.localhost:12443/api/auth/v1/login
# AUTH_REFRESH_URL=https://next.localhost:12443/api/auth/v1/refresh-tokens
# VITE_AUTH_REFRESH_URL=https://next.localhost:12443/api/auth/v1/refresh-tokens
# VITE_LK_BASE_URL=https://next.localhost:12443
# S3_ENDPOINT=http://127.0.0.1:5000
# S3_ACCESS_KEY=test
# S3_SECRET_KEY=test
# Для self-signed сертификата разрешено только локально:
# NODE_TLS_REJECT_UNAUTHORIZED=0
# Для Vite HMR через локальную HTTPS-прокси:
EDO_LOCAL_HTTPS=false
# Только e2e: отдельный test-секрет, совпадающий с JWT_SECRET тестового API.
# Не используйте production JWT_SECRET в тестах.
EDO_E2E_JWT_SECRET=
