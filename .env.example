# --- Database (MariaDB via Prisma, provider=mysql) ---
DATABASE_URL="mysql://edo:edo@localhost:3307/edo"

# --- API ---
API_PORT=3001
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Auth: unified JWT (HS256, lk-auth-service) ---
# EDO shares JWT_SECRET with the ecosystem auth service. Never commit real secret.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALG=HS256
JWT_ISSUER=lk-auth-service
# Explicit dev bypass ONLY. Works only when NODE_ENV=development/test. Default false.
ALLOW_INSECURE_DEV_AUTH=false
# Legacy (deprecated, kept for compat until removed): JWKS-based config, unused with HS256.
AUTH_JWKS_URL=
AUTH_AUDIENCE=
# Real LK auth-service refresh contract (versioned primary, legacy fallback):
# POST /api/auth/v1/refresh-tokens (legacy: POST /api/auth/refresh-tokens)
# Refresh token is HttpOnly cookie; request is POST credentials:include with `{}`.
# Response JSON is snake_case { access_token, ... } + Authorization: Bearer header.
# Local dev may override; production points at the shared auth-service host.
AUTH_REFRESH_URL=https://lk.sps38.pro/api/auth/v1/refresh-tokens
AUTH_LOGIN_URL=https://lk.sps38.pro/api/auth/v1/login
VITE_AUTH_REFRESH_URL=https://lk.sps38.pro/api/auth/v1/refresh-tokens
VITE_API_BASE_URL=http://localhost:3001
# Explicit frontend dev fallback (dev-demo-token). ONLY honored with Vite dev mode.
# Local dev: set true in your (gitignored) .env. Default false.
VITE_ALLOW_INSECURE_DEV_AUTH=false

# --- LK compact integration (server-to-server only, never expose to frontend) ---
# Base URL of lk.sps38.pro reachable from EDO server process (same Docker network in prod).
LK_BASE_URL=http://localhost:8080
# URL of the narrow EDO OpenAPI spec (next/openapi/edo.json) used to generate packages/lk-client.
LK_EDO_OPENAPI_URL=
# Service credential for GET /api/internal/edo/v1/*. Fail closed in production when empty.
LK_EDO_INTERNAL_TOKEN=

# --- RabbitMQ (shared ecosystem broker; EDO does NOT run its own prod broker) ---
# Production must point to shared Docker-network host, e.g. amqp://user:pass@rabbitmq:5672/vhost
# Local standalone dev: `docker compose --profile standalone up -d` -> amqp://guest:guest@localhost:5673
RABBITMQ_URL=amqp://guest:guest@localhost:5672
LK_EVENTS_EXCHANGE=lk.events
EDO_LK_QUEUE=edo.lk-reference-sync
# Set LK_EVENTS_CONSUME=0 to skip the consumer (openapi export, CI without broker).
LK_EVENTS_CONSUME=1

# --- E2E (dev/test only) ---
# Secret used by apps/web/e2e/fixture.ts to sign real HS256 JWTs.
# MUST equal the API JWT_SECRET. Never set in production.
EDO_E2E_JWT_SECRET=dev-only-insecure-secret-change-me

# --- Redis (shared cache/locks/ephemeral only; NOT a primary queue) ---
# Production must point to shared Redis in the common Docker network.
# Local standalone dev may use compose profile; see docker-compose.yml.
REDIS_URL=redis://localhost:6380

# --- S3-compatible storage ---
# Default local: moto mock (compose service `s3` on :5000).
# Prod-like MinIO: `docker compose --profile minio up -d`, then S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT=http://localhost:5000
S3_REGION=us-east-1
S3_BUCKET=edo-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
