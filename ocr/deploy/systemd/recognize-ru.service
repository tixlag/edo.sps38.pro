[Unit]
Description=EDO monorepo document OCR (RU)
After=network.target

[Service]
Type=simple
User=ocr
Group=ocr
WorkingDirectory=/opt/edo.sps38.pro/ocr
ExecStart=/bin/bash /opt/edo.sps38.pro/ocr/scripts/run_service.sh ru
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
