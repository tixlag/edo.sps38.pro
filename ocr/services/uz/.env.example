GLM_OCR_URL=http://127.0.0.1:8083/v1/chat/completions
GLM_OCR_MODEL=zai-org/GLM-OCR
DEVICE=0
USE_GPU=1
# Одна копия SigLIP 2 на CUDA, FP16; веса устанавливает runner до переключения.
DOCUMENT_CHECK_ENABLED=true
MIGRATION_FIO_GRID_STAGE_MODE=replace
# Optional absolute paths:
# MODELS_ROOT=/srv/ocr-models
# PADDLEOCR_ROOT=/srv/paddleocr
# SEGMENT_DUMP_ROOT=/srv/ocr-runtime/uz/segments

# GLM fallback for document type checking; unavailable service falls back to review.
DOCUMENT_TYPE_GLM_ENABLED=true
# legacy keeps current decisions; shadow records Xiaomi decisions without applying them.
# Enable xiaomi only after OCR validation and the API contract deployment.
DOCUMENT_TYPE_PROVIDER=legacy
DOCUMENT_TYPE_XIAOMI_URL=http://127.0.0.1:8084/recognize-text
