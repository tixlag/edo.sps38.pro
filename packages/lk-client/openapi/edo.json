{
    "openapi": "3.1.0",
    "info": {
        "title": "LK → EDO master data API",
        "version": "1.0.0"
    },
    "paths": {
        "\/api\/internal\/edo\/v1\/candidate-chats\/{chatUuid}": {
            "get": {
                "tags": [
                    "EDO candidate identity"
                ],
                "operationId": "edoGetCandidateChat",
                "parameters": [
                    {
                        "name": "chatUuid",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Canonical candidate identity",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/EdoCandidateChat"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid UUID"
                    },
                    "401": {
                        "description": "Invalid service credential"
                    },
                    "404": {
                        "description": "Chat not found"
                    },
                    "500": {
                        "description": "Service unavailable"
                    }
                },
                "security": [
                    {
                        "edoBearer": []
                    }
                ]
            }
        },
        "\/api\/internal\/edo\/v1\/employees\/{code1c}\/candidate-chat": {
            "get": {
                "tags": [
                    "EDO candidate identity"
                ],
                "operationId": "edoGetEmployeeCandidateChat",
                "parameters": [
                    {
                        "name": "code1c",
                        "in": "path",
                        "description": "Opaque employee code: Unicode letters, decimal digits, underscore, dot or hyphen; dot segments are forbidden. Case and leading zeros are preserved.",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "maxLength": 64,
                            "minLength": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Preferred candidate chat of this employee",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/EdoCandidateChat"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid code"
                    },
                    "401": {
                        "description": "Invalid service credential"
                    },
                    "404": {
                        "description": "Chat not found"
                    },
                    "500": {
                        "description": "Service unavailable"
                    }
                },
                "security": [
                    {
                        "edoBearer": []
                    }
                ]
            }
        },
        "\/api\/internal\/edo\/v1\/employees": {
            "get": {
                "tags": [
                    "EDO master data"
                ],
                "operationId": "edoListEmployees",
                "parameters": [
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 500,
                            "maximum": 1000,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "cursor",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Employee page",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/EdoEmployeePage"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "edoBearer": []
                    }
                ]
            }
        },
        "\/api\/internal\/edo\/v1\/locations": {
            "get": {
                "tags": [
                    "EDO master data"
                ],
                "operationId": "edoListLocations",
                "responses": {
                    "200": {
                        "description": "Locations",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#\/components\/schemas\/EdoLocation"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "edoBearer": []
                    }
                ]
            }
        },
        "\/api\/internal\/edo\/v1\/positions": {
            "get": {
                "tags": [
                    "EDO master data"
                ],
                "operationId": "edoListPositions",
                "responses": {
                    "200": {
                        "description": "Positions",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#\/components\/schemas\/EdoReference"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "edoBearer": []
                    }
                ]
            }
        },
        "\/api\/internal\/edo\/v1\/departments": {
            "get": {
                "tags": [
                    "EDO master data"
                ],
                "operationId": "edoListDepartments",
                "responses": {
                    "200": {
                        "description": "Departments",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#\/components\/schemas\/EdoReference"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "edoBearer": []
                    }
                ]
            }
        },
        "\/api\/internal\/edo\/v1\/notifications": {
            "post": {
                "tags": [
                    "EDO notifications"
                ],
                "summary": "Отправить уведомление от EDO",
                "operationId": "edoSendNotification",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "$ref": "#\/components\/schemas\/CreateEdoNotification"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Notification created",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "broadcastUuid": {
                                            "type": "string",
                                            "format": "uuid"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request"
                    },
                    "401": {
                        "description": "Invalid service credential"
                    },
                    "404": {
                        "description": "Recipients not found"
                    },
                    "500": {
                        "description": "Service unavailable"
                    }
                },
                "security": [
                    {
                        "edoBearer": []
                    }
                ]
            }
        },
        "\/api\/internal\/edo\/v1\/users\/{userUuid}\/notifications": {
            "get": {
                "tags": [
                    "EDO notifications"
                ],
                "summary": "Список уведомлений пользователя",
                "operationId": "edoListUserNotifications",
                "parameters": [
                    {
                        "name": "userUuid",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 20
                        }
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 0
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "all",
                            "enum": [
                                "all",
                                "read",
                                "unread"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User notifications with unreadCount",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/EdoUserNotificationsList"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid service credential"
                    }
                },
                "security": [
                    {
                        "edoBearer": []
                    }
                ]
            }
        },
        "\/api\/internal\/edo\/v1\/users\/{userUuid}\/notifications\/read": {
            "post": {
                "tags": [
                    "EDO notifications"
                ],
                "summary": "Отметить уведомления пользователя прочитанными",
                "operationId": "edoMarkUserNotificationsRead",
                "parameters": [
                    {
                        "name": "userUuid",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "properties": {
                                    "uuids": {
                                        "type": [
                                            "array",
                                            "null"
                                        ],
                                        "items": {
                                            "type": "string",
                                            "format": "uuid"
                                        }
                                    },
                                    "all": {
                                        "type": [
                                            "boolean",
                                            "null"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Marked as read",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "updated": {
                                            "type": "integer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid service credential"
                    }
                },
                "security": [
                    {
                        "edoBearer": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "EdoOrganization": {
                "required": [
                    "code",
                    "name"
                ],
                "properties": {
                    "code": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "type": "object"
            },
            "EdoLocationRef": {
                "required": [
                    "id",
                    "code1c",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "code1c": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "EdoEmployeePage": {
                "required": [
                    "items",
                    "nextCursor"
                ],
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#\/components\/schemas\/EdoEmployee"
                        }
                    },
                    "nextCursor": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "type": "object"
            },
            "EdoNotificationTarget": {
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "meta": {
                        "type": [
                            "object",
                            "null"
                        ]
                    }
                },
                "type": "object"
            },
            "EdoUserNotification": {
                "required": [
                    "uuid",
                    "title",
                    "content",
                    "cleanContent",
                    "type"
                ],
                "properties": {
                    "uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "title": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "cleanContent": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "toast",
                            "modal"
                        ]
                    },
                    "createdAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "deliveredAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "readAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "target": {
                        "oneOf": [
                            {
                                "$ref": "#\/components\/schemas\/EdoNotificationTarget"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "authorName": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "authorAvatarUrl": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "type": "object"
            },
            "EdoUserNotificationsList": {
                "required": [
                    "items",
                    "total",
                    "limit",
                    "offset",
                    "unreadCount"
                ],
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#\/components\/schemas\/EdoUserNotification"
                        }
                    },
                    "total": {
                        "type": "integer"
                    },
                    "limit": {
                        "type": "integer"
                    },
                    "offset": {
                        "type": "integer"
                    },
                    "unreadCount": {
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "EdoLocation": {
                "required": [
                    "id",
                    "code1c",
                    "name",
                    "shortName",
                    "generalUnitCode",
                    "deleted",
                    "updatedAt"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "code1c": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "shortName": {
                        "type": "string"
                    },
                    "generalUnitCode": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "deleted": {
                        "type": "boolean"
                    },
                    "updatedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "EdoCandidateChat": {
                "required": [
                    "chatUuid",
                    "code1c"
                ],
                "properties": {
                    "chatUuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "code1c": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "type": "object"
            },
            "EdoEmployee": {
                "required": [
                    "code1c",
                    "uuid",
                    "fullName",
                    "birthday",
                    "citizenship",
                    "organization",
                    "position",
                    "department",
                    "division",
                    "lastLocation",
                    "hireDate",
                    "fired",
                    "contractor",
                    "updatedAt"
                ],
                "properties": {
                    "code1c": {
                        "type": "string"
                    },
                    "uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "fullName": {
                        "type": "string"
                    },
                    "birthday": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date"
                    },
                    "citizenship": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "organization": {
                        "$ref": "#\/components\/schemas\/EdoOrganization"
                    },
                    "position": {
                        "$ref": "#\/components\/schemas\/EdoNamedCode"
                    },
                    "department": {
                        "$ref": "#\/components\/schemas\/EdoNamedCode"
                    },
                    "division": {
                        "$ref": "#\/components\/schemas\/EdoNamedCode"
                    },
                    "lastLocation": {
                        "oneOf": [
                            {
                                "$ref": "#\/components\/schemas\/EdoLocationRef"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "hireDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date"
                    },
                    "fired": {
                        "type": "boolean"
                    },
                    "contractor": {
                        "type": "boolean"
                    },
                    "updatedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "EdoNamedCode": {
                "required": [
                    "code1c",
                    "name"
                ],
                "properties": {
                    "code1c": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "type": "object"
            },
            "CreateEdoNotification": {
                "title": "CreateEdoNotificationDto",
                "description": "DTO для входящих уведомлений от EDO",
                "required": [
                    "title",
                    "content"
                ],
                "properties": {
                    "recipientCodes1c": {
                        "description": "Коды 1C получателей",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "authorCode1c": {
                        "description": "code_1c автора уведомления",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "title": {
                        "description": "Заголовок",
                        "type": "string"
                    },
                    "content": {
                        "description": "Контент (поддерживает Markdown)",
                        "type": "string"
                    },
                    "type": {
                        "description": "Тип уведомления (toast | modal)",
                        "type": "string",
                        "default": "toast",
                        "enum": [
                            "toast",
                            "modal"
                        ]
                    },
                    "targetType": {
                        "description": "Тип цели",
                        "type": "string",
                        "default": "document_expiration"
                    },
                    "targetUrl": {
                        "description": "URL для перехода",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "targetMeta": {
                        "description": "Метаданные цели",
                        "type": [
                            "object",
                            "null"
                        ]
                    },
                    "idempotencyKey": {
                        "description": "Стабильный ключ запроса для защиты от повторной отправки",
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 191
                    }
                },
                "type": "object"
            },
            "EdoReference": {
                "required": [
                    "code1c",
                    "name",
                    "deleted",
                    "updatedAt"
                ],
                "properties": {
                    "code1c": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "deleted": {
                        "type": "boolean"
                    },
                    "updatedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "edoBearer": {
                "type": "http",
                "bearerFormat": "opaque",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "EDO candidate identity"
        },
        {
            "name": "EDO master data"
        },
        {
            "name": "EDO notifications",
            "description": "Служебный вход для EDO: отправка и чтение уведомлений"
        }
    ]
}
