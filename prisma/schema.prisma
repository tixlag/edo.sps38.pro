generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  INVITED
  ONBOARDING
  BLOCKED
  IN_REVIEW
  SIGNING
  HIRED
}

enum DocumentStatus {
  DRAFT
  UPLOADED
  OCR_PENDING
  OCR_FAILED
  IN_REVIEW
  RETURNED
  APPROVED
  SIGNED
  EXPIRED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum AuditAction {
  EMPLOYEE_CREATED
  DOCUMENT_UPLOADED
  DOCUMENT_RETURNED
  DOCUMENT_APPROVED
  DOCUMENT_SIGNED
  WORKFLOW_STAGE_CHANGED
  DATA_IMPORTED
  LK_REFERENCE_SYNCED
  LK_EVENT_APPLIED
}

model Employee {
  id        String         @id @default(cuid()) @db.VarChar(64)
  fullName  String         @db.VarChar(255)
  country   String?        @db.VarChar(128)
  position  String?        @db.VarChar(255)
  status    EmployeeStatus @default(INVITED)
  stage     String?        @db.VarChar(255)
  createdAt DateTime       @default(now()) @db.DateTime(3)
  updatedAt DateTime       @updatedAt @db.DateTime(3)

  // Explicit link to the LK master-data projection (nullable: a case may exist
  // before the person appears in LK; never auto-matched by fullName).
  lkEmployeeCode1c String? @db.VarChar(64)
  // Access object for the case: explicitly fixed location (object) of the case.
  // Null means "no object set" and is NOT visible to scoped (20007) users.
  locationId Int?

  documents Document[]
  tasks     Task[]
  auditLogs AuditLog[] @relation("AuditEntityEmployee")

  @@index([lkEmployeeCode1c])
  @@index([locationId])
  @@map("employees")
}

model DocumentType {
  id        String   @id @default(cuid()) @db.VarChar(64)
  code      String   @unique @db.VarChar(64)
  title     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.DateTime(3)

  documents Document[]

  @@map("document_types")
}

model Document {
  id             String         @id @default(cuid()) @db.VarChar(64)
  employeeId     String         @db.VarChar(64)
  documentTypeId String?        @db.VarChar(64)
  status         DocumentStatus @default(DRAFT)
  currentVersion Int            @default(1)
  createdAt      DateTime       @default(now()) @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @db.DateTime(3)

  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType DocumentType?  @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  versions     DocumentVersion[]
  auditLogs    AuditLog[]     @relation("AuditEntityDocument")

  @@index([employeeId])
  @@index([status])
  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(cuid()) @db.VarChar(64)
  documentId String   @db.VarChar(64)
  version    Int
  storageKey String   @db.VarChar(1024)
  mimeType   String?  @db.VarChar(128)
  sizeBytes  Int?
  ocrRaw     Json?
  createdAt  DateTime @default(now()) @db.DateTime(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@map("document_versions")
}

model Task {
  id         String     @id @default(cuid()) @db.VarChar(64)
  title      String     @db.VarChar(512)
  assignee   String?    @db.VarChar(255)
  employeeId String?    @db.VarChar(64)
  status     TaskStatus @default(TODO)
  dueDate    DateTime?  @db.DateTime(3)
  createdAt  DateTime   @default(now()) @db.DateTime(3)
  updatedAt  DateTime   @updatedAt @db.DateTime(3)

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("tasks")
}

model AuditLog {
  id            String      @id @default(cuid()) @db.VarChar(64)
  actorId       String?     @db.VarChar(64)
  action        AuditAction
  entityType    String      @db.VarChar(64)
  entityId      String      @db.VarChar(64)
  before        Json?
  after         Json?
  correlationId String?     @db.VarChar(64)
  createdAt     DateTime    @default(now()) @db.DateTime(3)

  employee Employee? @relation("AuditEntityEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  employeeId String? @db.VarChar(64)
  document Document? @relation("AuditEntityDocument", fields: [documentId], references: [id], onDelete: SetNull)
  documentId String? @db.VarChar(64)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// LK master-data read model (local projection, source of truth = lk.sps38.pro).
// Table/model names carry the Lk prefix to never mix with EDO domain entities.
// EDO business entities reference these via stable external keys (code_1c),
// e.g. EmployeeOnboarding.lkEmployeeCode1c. No runtime direct DB access to LK.
// Column lengths mirror prisma/migrations/0001_init + 0002_lk_read_model.
// Reconciliation marking: lastSeenSyncId is set on every row seen during a full
// snapshot; rows unseen after a SUCCESSFUL snapshot are marked deleted (refs)
// or sourcePresent=false (employees). Partial snapshots never mark missing.
// `fired` is a business dismissal status and is never set by absence.
// ---------------------------------------------------------------------------

model LkEmployee {
  code1c               String    @id @map("code1c") @db.VarChar(64)
  uuid                 String    @db.VarChar(64)
  fullName             String    @db.VarChar(512)
  birthday             DateTime? @db.DateTime(3)
  citizenship          String?   @db.VarChar(128)
  organizationCode     String?   @db.VarChar(64)
  organizationName     String?   @db.VarChar(512)
  positionCode1c       String?   @db.VarChar(64)
  positionName         String?   @db.VarChar(512)
  departmentCode1c     String?   @db.VarChar(64)
  departmentName       String?   @db.VarChar(512)
  divisionCode1c       String?   @db.VarChar(64)
  divisionName         String?   @db.VarChar(512)
  lastLocationId       Int?
  lastLocationCode1c   String?   @db.VarChar(64)
  lastLocationName     String?   @db.VarChar(512)
  hireDate             DateTime? @db.DateTime(3)
  fired                Boolean   @default(false)
  contractor           Boolean   @default(false)
  sourceUpdatedAt      DateTime? @db.DateTime(3)
  syncedAt             DateTime  @default(now()) @db.DateTime(3)
  createdAt            DateTime  @default(now()) @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @db.DateTime(3)
  lastSeenSyncId       String?   @db.VarChar(64)
  sourcePresent        Boolean   @default(true)

  @@index([uuid])
  @@index([fired])
  @@index([syncedAt])
  @@map("lk_employees")
}

model LkLocation {
  code1c          String    @id @map("code1c") @db.VarChar(64)
  locationId      Int       @unique @map("locationId")
  name            String    @db.VarChar(512)
  shortName       String    @default("") @db.VarChar(512)
  generalUnitCode String?   @db.VarChar(64)
  deleted         Boolean   @default(false)
  sourceUpdatedAt DateTime? @db.DateTime(3)
  syncedAt        DateTime  @default(now()) @db.DateTime(3)
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
  lastSeenSyncId  String?   @db.VarChar(64)

  @@index([deleted])
  @@map("lk_locations")
}

model LkPosition {
  code1c          String    @id @map("code1c") @db.VarChar(64)
  name            String    @db.VarChar(512)
  deleted         Boolean   @default(false)
  sourceUpdatedAt DateTime? @db.DateTime(3)
  syncedAt        DateTime  @default(now()) @db.DateTime(3)
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
  lastSeenSyncId  String?   @db.VarChar(64)

  @@map("lk_positions")
}

model LkDepartment {
  code1c          String    @id @map("code1c") @db.VarChar(64)
  name            String    @db.VarChar(512)
  deleted         Boolean   @default(false)
  sourceUpdatedAt DateTime? @db.DateTime(3)
  syncedAt        DateTime  @default(now()) @db.DateTime(3)
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
  lastSeenSyncId  String?   @db.VarChar(64)

  @@map("lk_departments")
}

/// Idempotency inbox for RabbitMQ lk.reference.* events. eventId is globally unique.
model LkProcessedEvent {
  eventId     String    @id @map("eventId") @db.VarChar(64)
  eventType   String    @db.VarChar(128)
  version     Int       @default(1)
  occurredAt  DateTime? @db.DateTime(3)
  receivedAt  DateTime  @default(now()) @db.DateTime(3)
  entityCode  String?   @db.VarChar(64)

  @@index([eventType])
  @@index([receivedAt])
  @@map("lk_processed_events")
}

/// Durable sync-run ledger + fencing generation for snapshot-vs-events.
/// A snapshot creates a RUNNING row at start (after acquiring the Redis lock)
/// and flips it to FINISHED/FAILED at end. The monotonic `id` is the fencing
/// generation: consumers check atomically in the same DB transaction as the
/// inbox+projection write that no RUNNING run exists (late admits abort as
/// transient); markMissing runs only when the current run is still the latest
/// RUNNING and the Redis lock is still owned. Crashed RUNNING rows are
/// reconciled by TTL expiry + operator runbook (never auto-deleted).
model LkSyncRun {
  id            Int       @id @default(autoincrement())
  runId         String    @unique @db.VarChar(64)
  status        String    @db.VarChar(16)
  startedAt     DateTime  @default(now()) @db.DateTime(3)
  finishedAt    DateTime? @db.DateTime(3)
  locations     Int       @default(0)
  positions     Int       @default(0)
  departments   Int       @default(0)
  employees     Int       @default(0)
  errorCategory String?   @db.VarChar(64)
  errorMessage  String?   @db.VarChar(1024)

  @@index([status])
  @@index([startedAt])
  @@map("lk_sync_runs")
}
