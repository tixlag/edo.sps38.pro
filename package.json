{
  "name": "edo-sps38",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "api:generate": "turbo api:generate",
    "db:migrate": "node scripts/assert-edo-database.js && dotenv -e .env -- pnpm --filter @edo/api exec prisma migrate deploy --schema ../../prisma/schema.prisma",
    "db:migrate:dev": "node scripts/assert-edo-database.js && dotenv -e .env -- pnpm --filter @edo/api exec prisma migrate dev --schema ../../prisma/schema.prisma",
    "db:seed": "node scripts/assert-edo-database.js && pnpm --filter @edo/api db:seed",
    "docker:up": "docker compose up -d s3",
    "s3:up": "docker compose up -d s3",
    "infra:check": "pnpm --filter @edo/api infra:check",
    "local:up": "node scripts/local-stand.mjs up",
    "local:down": "node scripts/local-stand.mjs down",
    "local:status": "node scripts/local-stand.mjs status",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@prisma/client": "6.2.1",
    "dotenv-cli": "7.4.2",
    "prettier": "3.8.1",
    "prisma": "6.2.1",
    "turbo": "2.5.4",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
