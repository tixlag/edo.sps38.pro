{
  "name": "@edo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint src test --ext .ts",
    "test": "vitest run",
    "openapi:export": "DATABASE_URL=mysql://edo:edo@localhost:3307/edo JWT_SECRET=export-only-insecure-secret LK_EVENTS_CONSUME=0 ts-node --transpile-only scripts/export-openapi.ts",
    "api:generate": "pnpm openapi:export && orval --config ../../orval.config.ts",
    "db:seed": "dotenv run -f ../../.env -- ts-node --transpile-only prisma/seed.ts",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "lk:sync": "dotenv run -f ../../.env -- ts-node --transpile-only src/lk-sync/run-sync.ts",
    "lk:topology": "dotenv run -f ../../.env -- ts-node --transpile-only src/lk-sync/run-topology.ts"
  },
  "dependencies": {
    "@edo/lk-client": "workspace:^",
    "@fastify/cors": "10.0.1",
    "@fastify/static": "8.1.1",
    "@nestjs/common": "11.0.12",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.12",
    "@nestjs/platform-fastify": "11.0.12",
    "@nestjs/swagger": "11.0.3",
    "@prisma/client": "6.2.1",
    "amqplib": "^2.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "^18.0.4",
    "ioredis": "5.4.1",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@edo/eslint-config": "workspace:*",
    "@edo/tsconfig": "workspace:*",
    "@nestjs/cli": "11.0.5",
    "@nestjs/testing": "11.0.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.10.7",
    "eslint": "8.57.1",
    "orval": "7.5.0",
    "prisma": "6.2.1",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
