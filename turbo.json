{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "api:generate"],
      "outputs": ["dist/**"]
    },
    "api:generate": {
      "outputs": ["../../packages/api-client/src/generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {}
  }
}
